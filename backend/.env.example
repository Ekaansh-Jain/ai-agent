# Copy to `.env` and fill in. The LLM is optional — without a key, NEXUS falls back to the
# deterministic intent parser + template narrator (all tests still pass).

# Google AI Studio API key (free tier): https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-key-here

# Free-tier model. gemini-2.0-flash (or gemini-1.5-flash) are free with generous limits.
GEMINI_MODEL=gemini-2.0-flash

# Set to 0 to force the deterministic path even when a key is present.
NEXUS_USE_LLM=1
